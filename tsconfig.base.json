{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "mobile-tokens": ["packages/mobile-tokens/src/index.ts"],
      "mobile-ui": ["packages/mobile-ui/src/index.ts"],
      "mobile-data": ["packages/mobile-data/src/index.ts"]
    }
  }
}
