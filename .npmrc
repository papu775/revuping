# Hoist native modules to root to avoid duplicate native modules in monorepo
shamefully-hoist=true
hoist-pattern[]=*react-native*
hoist-pattern[]=*@react-native*
hoist-pattern[]=*expo*
hoist-pattern[]=*@expo*
hoist-pattern[]=react
hoist-pattern[]=react-dom
hoist-pattern[]=react-native*
hoist-pattern[]=@react-native*
hoist-pattern[]=@expo/*
auto-install-peers=true
dedupe-peer-dependents=true
resolve-peers-from-workspace-root=false