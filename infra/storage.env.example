# Add to the API's local environment only. Never put these in public app variables.
S3_LOCAL_EMULATOR=true
S3_ENDPOINT=http://127.0.0.1:4566
S3_REGION=us-east-1
S3_BUCKET=revuping-logos
S3_FORCE_PATH_STYLE=true
# Local mode uses test/test internally. Real S3 uses the server credential chain,
# or both S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY from managed configuration.
# Production: S3_LOCAL_EMULATOR=false; omit S3_ENDPOINT for AWS S3.
