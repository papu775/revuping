{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "sourceRoot": "apps/web/src",
    "targets": {
      "auth-feedback-check": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node apps/web/scripts/check-auth-feedback.cjs"
        }
      },
      "auth-preview": {
        "executor": "nx:run-commands",
        "continuous": true,
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "apps/web",
          "command": "next start --port 3010 --hostname 127.0.0.1",
          "env": {
            "NODE_ENV": "production"
          }
        }
      },
      "build": {
        "options": {
          "env": {
            "NODE_ENV": "production"
          }
        },
        "inputs": [
          "default",
          "^default",
          {
            "externalDependencies": [
              "next"
            ]
          },
          {
            "dependentTasksOutputFiles": "**/*.d.ts",
            "transitive": true
          },
          {
            "env": "NEXT_PUBLIC_API_URL"
          }
        ]
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc --noEmit -p apps/web/tsconfig.json"
        },
        "cache": true,
        "outputs": [
          "{projectRoot}/dist/tsconfig.tsbuildinfo"
        ]
      },
      "prototype-check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node apps/web/scripts/check-prototype.cjs"
        },
        "cache": false
      },
      "audit-check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node apps/web/scripts/check-audit.cjs"
        },
        "cache": false
      },
      "refinement-check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node apps/web/scripts/check-refinements.cjs"
        },
        "cache": false
      },
      "hero-check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node apps/web/scripts/check-hero.cjs"
        },
        "cache": false
      },
      "quality-check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node apps/web/scripts/check-quality.cjs"
        },
        "cache": false
      },
      "notification-check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node apps/web/scripts/check-notifications.cjs"
        },
        "cache": false
      },
      "product-check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node apps/web/scripts/check-product.cjs"
        },
        "cache": false
      },
      "dev": {
        "options": {
          "command": "next dev --port 3000"
        },
        "cache": false
      },
      "start": {
        "options": {
          "command": "next start --port 3000"
        },
        "cache": false
      },
      "serve-static": {
        "options": {
          "command": "next start --port 3000"
        },
        "cache": false
      },
      "design-check": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node apps/web/scripts/check-design.cjs"
        }
      },
      "onboarding-check": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node apps/web/scripts/check-onboarding.cjs"
        }
      },
      "verification-check": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node apps/web/scripts/check-verification-states.cjs"
        }
      },
      "routing-check": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node apps/web/scripts/check-navigation.cjs"
        }
      }
    },
    "tags": [
      "scope:web",
      "platform:browser",
      "type:app"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "api-contracts": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "next": "~16.3.6",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "tailwindcss": "^4.3.3"
  }
}
