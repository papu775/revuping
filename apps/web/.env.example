# Optional, used only by the opt-in connectivity client; demos stay local.
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1

# Server-only Next proxy upstream. Required in production; never NEXT_PUBLIC.
API_INTERNAL_URL=http://127.0.0.1:3002/api/v1
# Enable only behind ingress that overwrites X-Forwarded-For and blocks direct
# public access to Next. Configure matching API TRUSTED_PROXIES explicitly.
AUTH_TRUST_EDGE_HEADERS=false
# Never put secrets in NEXT_PUBLIC_* variables; those are bundled for browsers.
