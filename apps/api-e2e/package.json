{
  "name": "api-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "api",
      "web",
      "mobile"
    ],
    "targets": {
      "web-auth-check": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "api:serve",
          "web:auth-preview"
        ],
        "options": {
          "command": "node apps/api-e2e/scripts/check-web-auth.cjs"
        }
      },
      "auth-check": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "api:build",
          "api:serve"
        ],
        "options": {
          "command": "node apps/api-e2e/scripts/check-auth.cjs"
        }
      },
      "connectivity-check": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "api:build",
          "api:serve"
        ],
        "cache": false,
        "options": {
          "cwd": ".",
          "command": "node apps/api-e2e/scripts/check-connectivity.cjs"
        }
      },
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "api:build",
          "api:serve"
        ],
        "options": {
          "jestConfig": "apps/api-e2e/jest.config.cts",
          "runInBand": true
        },
        "cache": false
      },
      "onboarding-check": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node apps/api-e2e/scripts/check-onboarding.cjs"
        }
      }
    },
    "tags": [
      "scope:api",
      "platform:test",
      "type:e2e"
    ]
  }
}
