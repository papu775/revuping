generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  STAFF
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique @db.Citext
  displayName        String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  memberships        Membership[]
  passwordHash       String?
  emailVerifiedAt    DateTime?           @db.Timestamptz(3)
  credentialVersion  Int                 @default(0)
  sessions           Session[]
  actionTokens       EmailActionToken[]
  workspaceCreations WorkspaceCreation[]
  assignedFeedback PrivateFeedback[] @relation("FeedbackAssignee")
}

model Workspace {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  memberships Membership[]
  business    Business?
  locations   Location[]
  creations   WorkspaceCreation[]
  feedback    PrivateFeedback[]
  feedbackActivity FeedbackActivity[]
  settings WorkspaceSettings?
  invitations TeamInvitation[]
}

enum SessionKind {
  WEB
  NATIVE
}

enum EmailAction {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model Session {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  kind            SessionKind
  secretHash      String         @unique @db.Char(64)
  csrfHash        String?        @db.Char(64)
  accessExpiresAt DateTime       @db.Timestamptz(3)
  expiresAt       DateTime       @db.Timestamptz(3)
  revokedAt       DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens   RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// Consumed refresh hashes are retained until family expiry to detect replay.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
}

model EmailActionToken {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  purpose    EmailAction
  tokenHash  String      @unique @db.Char(64)
  expiresAt  DateTime    @db.Timestamptz(3)
  consumedAt DateTime?   @db.Timestamptz(3)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model WorkspaceCreation {
  userId      String    @db.Uuid
  key         String    @db.VarChar(64)
  workspaceId String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([workspaceId])
}

model Membership {
  revision Int @default(0)
  workspaceId String         @db.Uuid
  userId      String         @db.Uuid
  role        MembershipRole
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model LogoObject {
  key         String   @id
  workspaceId String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  @@index([createdAt])
}

model Business {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @unique @db.Uuid
  draft       Json?
  revision    Int        @default(0)
  completedAt DateTime?   @db.Timestamptz(3)
  logoKey     String?     @unique
  name        String
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  locations   Location[]

  // Enables a tenant-consistent composite foreign key on Location.
  @@unique([id, workspaceId])
}

model Location {
  creationKey String? @db.Uuid
  detailsRevision Int @default(0)
  archivedAt DateTime? @db.Timestamptz(3)
  publicId String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerEnabled Boolean @default(true)
  qrRevision Int @default(0)
  qrDisplayName String @default("") @db.VarChar(100)
  qrDisplayText String @default("How was your visit?") @db.VarChar(120)
  qrBrandColor String? @db.VarChar(7)
  qrLayout String @default("Counter card")
  googleReviewUrl String? @db.VarChar(500)
  feedback PrivateFeedback[]
  closedDays  Json?
  timezone    String    @default("UTC")
  hours       Json?
  isPrimary   Boolean   @default(false)
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  businessId  String    @db.Uuid
  name        String
  address     String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  business    Business  @relation(fields: [businessId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workspaceId, creationKey])
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([businessId, workspaceId])
}

model PrivateFeedback {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  locationId String @db.Uuid
  submissionKey String @db.Uuid
  payloadHash String @db.Char(64)
  rating Int
  message String @db.VarChar(2000)
  name String? @db.VarChar(100)
  email String? @db.VarChar(254)
  status String @default("UNRESOLVED")
  revision Int @default(0)
  assigneeId String? @db.Uuid
  assignee User? @relation("FeedbackAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority String @default("NORMAL")
  dueDate String @default("") @db.VarChar(10)
  tags String @default("") @db.VarChar(100)
  resolutionSummary String @default("") @db.VarChar(2000)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  activity FeedbackActivity[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  location Location @relation(fields: [locationId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: NoAction)
  @@unique([id, workspaceId])
  @@unique([locationId, submissionKey])
  @@index([workspaceId, createdAt])
  @@index([locationId, status, createdAt])
}

// Immutable private activity: notes and plan changes keep the authenticated actor snapshot.
model FeedbackActivity {
  id String @id @default(uuid()) @db.Uuid
  feedbackId String @db.Uuid
  workspaceId String @db.Uuid
  key String @db.Uuid
  kind String
  body String @db.VarChar(2000)
  actorId String @db.Uuid
  actorName String @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  feedback PrivateFeedback @relation(fields: [feedbackId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: NoAction)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([feedbackId, key])
  @@index([workspaceId, feedbackId, createdAt])
}

model WorkspaceSettings {
  workspaceId String @id @db.Uuid
  revision Int @default(0)
  weekly Boolean @default(false)
  feedback Boolean @default(false)
  reminders Boolean @default(false)
  requestTemplate String @default("Hi {name}, thanks for visiting. Share your experience: {link}") @db.VarChar(2000)
  rebookingTemplate String @default("Hi {name}, ready for another visit? {link}") @db.VarChar(2000)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model TeamInvitation {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  key String @db.Uuid
  email String @db.Citext
  name String @db.VarChar(100)
  role MembershipRole @default(STAFF)
  createdBy String @db.Uuid
  tokenHash String? @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  acceptedBy String? @db.Uuid
  revokedAt DateTime? @db.Timestamptz(3)
  delivery String @default("PENDING")
  revision Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, key])
  @@index([workspaceId, createdAt])
}
