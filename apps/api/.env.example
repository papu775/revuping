# API-only configuration; no values from this file belong in frontend bundles.
# Matches infra/.env.example. These credentials are for local development only.
NODE_ENV=development
API_HOST=127.0.0.1
PORT=3002
DATABASE_URL=postgresql://revuping:local-revuping-db@127.0.0.1:5433/revuping
REDIS_URL=redis://:local-revuping-redis@127.0.0.1:6380/0
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,http://localhost:8081
API_DOCS_ENABLED=true
LOG_LEVEL=info

# Trusted origin for browser mutations and email links; no trailing slash.
WEB_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=accounts@revuping.test
# Production SMTP credentials (optional when the relay is authorized by network):
# SMTP_USER=
# SMTP_PASSWORD=
# Exact trusted reverse-proxy IPs/CIDRs, comma separated. Empty trusts none.
TRUSTED_PROXIES=
AUTH_RATE_NAMESPACE=rp:auth
