{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "prisma-generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/prisma/schema.prisma",
          "{projectRoot}/prisma.config.ts",
          "{workspaceRoot}/pnpm-lock.yaml"
        ],
        "outputs": [
          "{projectRoot}/src/generated/prisma"
        ],
        "options": {
          "cwd": "apps/api",
          "command": "prisma generate",
          "env": {
            "DATABASE_URL": "postgresql://generation.invalid/unused"
          }
        }
      },
      "prisma-validate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/prisma/schema.prisma",
          "{projectRoot}/prisma.config.ts",
          "{workspaceRoot}/pnpm-lock.yaml"
        ],
        "options": {
          "cwd": "apps/api",
          "command": "prisma validate",
          "env": {
            "DATABASE_URL": "postgresql://generation.invalid/unused"
          }
        }
      },
      "migrate-deploy": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/api",
          "command": "prisma migrate deploy"
        }
      },
      "migrate-dev": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/api",
          "command": "prisma migrate dev"
        }
      },
      "migration-status": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/api",
          "command": "prisma migrate status"
        }
      },
      "migration-diff": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/api",
          "command": "prisma migrate diff"
        }
      },
      "schema-check": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/api",
          "command": "node scripts/check-schema.cjs"
        }
      },
      "build": {
        "dependsOn": [
          "^build",
          "prisma-generate"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck",
          "prisma-generate"
        ]
      },
      "lint": {
        "options": {
          "command": "eslint . --ignore-pattern src/generated/**"
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/api/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/api/dist/patches",
          "{workspaceRoot}/apps/api/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api:build",
          "inspect": false,
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "api:build:development"
          },
          "production": {
            "buildTarget": "api:build:production"
          }
        }
      },
      "test": {
        "dependsOn": [
          "^build",
          "prisma-generate"
        ],
        "options": {
          "command": "jest --runInBand"
        }
      }
    },
    "tags": [
      "scope:api",
      "platform:server",
      "type:app"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "api-contracts": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "5.11.1",
    "pg": "8.16.3",
    "pino": "9.14.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "5.0.6",
    "@types/pg": "8.16.0",
    "prisma": "7.10.0"
  }
}
