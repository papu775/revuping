{
  "name": "mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/mobile/src",
  "projectType": "application",
  "tags": ["scope:mobile", "platform:native", "type:app"],
  "// targets": "to see all targets run: nx show project mobile --web",
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "cwd": "apps/mobile",
        "command": "expo start"
      }
    },
    "export": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "apps/mobile",
        "command": "expo export",
        "args": []
      }
    },
    "dependency-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/mobile",
        "command": "expo install --check",
        "env": {
          "CI": "1"
        }
      }
    },
    "android-build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/mobile/android",
        "command": "./gradlew :app:assembleDebug --no-daemon"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "cwd": "apps/mobile",
        "command": "expo start --web",
        "args": []
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/mobile/android",
        "command": "./gradlew :app:assembleDebug --no-daemon"
      }
    },
    "prebuild": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/mobile",
        "command": "expo prebuild --no-clean --no-install --skip-dependency-update react,react-native"
      }
    },
    "ux-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": ".",
        "command": "node apps/mobile/scripts/check-refinement.cjs"
      }
    }
  }
}
